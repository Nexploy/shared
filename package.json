{
  "name": "@nexploy/shared",
  "version": "0.3.0",
  "description": "Shared primitives for Nexploy — Docker constants, infrastructure filters and path safety helpers.",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nexploy/shared.git"
  },
  "homepage": "https://github.com/Nexploy/shared#readme",
  "bugs": {
    "url": "https://github.com/Nexploy/shared/issues"
  },
  "keywords": [
    "nexploy",
    "docker",
    "deployment"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.7.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
